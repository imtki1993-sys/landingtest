# Variables d'environnement de LandPro (à définir dans Vercel → Settings → Environment Variables)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Chiffrement des clés d'intégration des clients (OpenAI…) — longue chaîne aléatoire, ne jamais changer
INTEGRATION_ENCRYPTION_KEY=

# IA
MODEL_API_KEY=

# Tâches planifiées Vercel (vercel.json) : secret envoyé dans Authorization: Bearer
CRON_SECRET=

# Meta (API Conversions)
META_GRAPH_VERSION=

# Déploiement / domaines (API Vercel)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optionnel : alerte instantanée à chaque erreur serveur (URL de webhook Slack, Discord, Google Chat, Make…)
ERROR_WEBHOOK_URL=
